{
  "name": "haiilo-documentation",
  "version": "0.0.15",
  "private": true,
  "scripts": {
    "prebuild": "node --import tsx scripts/prebuild.mjs",
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "sync:catalyst-assets": "mkdir -p public/catalyst/assets && cp node_modules/@haiilo/catalyst/dist/catalyst/catalyst.css public/catalyst/ && cp -R node_modules/@haiilo/catalyst/dist/catalyst/assets/. public/catalyst/assets/ && cp node_modules/@haiilo/catalyst-tokens/dist/css/variables.css public/catalyst/",
    "sync:catalyst-docs": "tsx scripts/sync-catalyst-docs.mjs",
    "postinstall": "pnpm sync:catalyst-assets",
    "test": "tsx --test src/lib/catalyst/*.test.ts",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "oxlint",
    "analyze": "npx fallow --only dead-code,dupes"
  },
  "dependencies": {
    "@haiilo/catalyst": "^14.13.0",
    "@haiilo/catalyst-icons": "^2.34.6",
    "fumadocs-core": "16.14.4",
    "fumadocs-mdx": "15.2.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.14.4",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "takumi-js": "^2.7.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@haiilo/catalyst-tokens": "^14.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxlint": "^1.78.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  }
}